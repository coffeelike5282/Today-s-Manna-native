__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.getRandomPrayerResolution=e.PRAYER_RESOLUTIONS=void 0;var o=e.PRAYER_RESOLUTIONS=[{ko:{prayer:"\uc8fc\ub2d8, \uc624\ub298 \ud558\ub8e8\ub3c4 \uc81c \uac78\uc74c\uc744 \uc778\ub3c4\ud558\uc2dc\uace0 \uc8fc\ub2d8\uc758 \uc601\uad11\uc744 \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ub9cc\ub098\ub294 \ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \ub530\ub73b\ud55c \ubbf8\uc18c\ub85c \uc778\uc0ac\ud558\uae30"},en:{prayer:"Lord, lead my steps today and let me see Your glory.",resolution:"Greet everyone I meet today with a warm smile."}},{ko:{prayer:"\uc8fc\uc2e0 \ub9d0\uc500\uc774 \uc81c \uc0b6\uc758 \uc591\uc2dd\uc774 \ub418\uc5b4, \uc138\uc0c1 \uc18d\uc5d0\uc11c \ube5b\uacfc \uc18c\uae08\uc73c\ub85c \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\ubd88\ud3c9\ud558\ub294 \ub300\uc2e0 \uac10\uc0ac\uc758 \uace0\ubc31 3\ubc88 \uc774\uc0c1 \ud558\uae30"},en:{prayer:"Let the Word become my daily bread, to live as light and salt in this world.",resolution:"Say at least 3 things I'm thankful for instead of complaining."}},{ko:{prayer:"\ub0b4 \uc0dd\uac01\ubcf4\ub2e4 \ud06c\uc2e0 \uc8fc\ub2d8\uc758 \uacc4\ud68d\uc744 \uc2e0\ub8b0\ud558\uba70, \uc624\ub298 \ud558\ub8e8\ub3c4 \ud3c9\uc548\uc744 \ub204\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\uc5b4\ub824\uc6b4 \uc0c1\ud669\uc5d0\uc11c\ub3c4 '\uc8fc\ub2d8\uc774 \ud558\uc2e4 \uac70\uc57c'\ub77c\uace0 \uc120\ud3ec\ud558\uae30"},en:{prayer:"Trusting in Your plan which is greater than mine, let me enjoy peace today.",resolution:"Declare 'The Lord will do it' even in difficult situations."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \uc0ac\ub791\uc774 \uc81c \ub9c8\uc74c\uc744 \ucc44\uc6cc, \uadf8 \uc0ac\ub791\uc744 \ud758\ub824\ubcf4\ub0b4\ub294 \ucd95\ubcf5\uc758 \ud1b5\ub85c\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ub3c4\uc6c0\uc774 \ud544\uc694\ud55c \uc0ac\ub78c\uc5d0\uac8c \uba3c\uc800 \uc190 \ub0b4\ubc00\uc5b4 \ub3d5\uae30"},en:{prayer:"Fill my heart with Your love, so I can be a channel of blessing to others.",resolution:"Reach out and help someone in need today."}},{ko:{prayer:"\ub9d0\uc500 \uc55e\uc5d0\uc11c \uc800 \uc790\uc2e0\uc744 \ub3cc\uc544\ubcf4\uace0, \uc8fc\ub2d8 \ubcf4\uc2dc\uae30\uc5d0 \uc544\ub984\ub2e4\uc6b4 \uc0b6\uc73c\ub85c \ube5a\uc5b4\uc8fc\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 SNS\ub098 \ubbf8\ub514\uc5b4 \uc0ac\uc6a9 \uc2dc\uac04\uc744 30\ubd84 \uc904\uc774\uace0 \ubb35\uc0c1\ud558\uae30"},en:{prayer:"Reflecting on myself before Your Word, mold me into a life beautiful in Your eyes.",resolution:"Reduce SNS/media usage by 30 mins and meditate today."}},{ko:{prayer:"\ub098\ub97c \uc0ac\ub791\ud558\uc2dc\ub294 \uc8fc\ub2d8, \uc624\ub298 \ud558\ub8e8\ub3c4 \uc8fc\uc758 \uc740\ud61c \uc548\uc5d0\uc11c \uc0b4\uc544\uac00\uac8c \ud558\uc18c\uc11c.",resolution:"\uc8fc\ubcc0\uc758 \uace0\ub9c8\uc6b4 \ubd84 1\uba85\uc5d0\uac8c \uac10\uc0ac\uc758 \uba54\uc2dc\uc9c0 \ubcf4\ub0b4\uae30"},en:{prayer:"Lord who loves me, let me live within Your grace today.",resolution:"Send a message of gratitude to one person you're thankful for."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \ub9c8\uc74c\uc5d0 \uc8fc\uac00 \uc8fc\uc2dc\ub294 \uae30\uc068\uc774 \ub118\uce58\uac8c \ud558\uc2dc\uace0 \uadf8 \uae30\uc068\uc744 \uc804\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc7a5\uc810\uc744 \ud558\ub098\uc529 \ucc3e\uc544 \uce6d\ucc2c\ud558\uae30"},en:{prayer:"Lord, fill my heart with Your joy and let me share that joy with others.",resolution:"Find one good thing about people you meet today and compliment them."}},{ko:{prayer:"\uacb8\uc190\ud55c \ub9c8\uc74c\uc744 \uc8fc\uc154\uc11c \uc8fc\ub2d8\uc758 \ub73b\uc744 \uc628\uc804\ud788 \ub530\ub974\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4\uac00 \uc633\ub2e4\uace0 \uc8fc\uc7a5\ud558\uae30\ubcf4\ub2e4 \ud55c \ubc88 \ub354 \ub4e4\uc5b4\uc8fc\uae30"},en:{prayer:"Give me a humble heart to fully follow Your will.",resolution:"Listen more rather than insisting on being right."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uc785\uc220\uc5d0 \ud30c\uc218\uafbc\uc744 \uc138\uc6cc \uc8fc\uc2dc\uace0 \uc624\uc9c1 \uc120\ud55c \ub9d0\ub9cc \ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \ubd80\uc815\uc801\uc778 \ub9d0\uc774\ub098 \ub4b7\ub2f4\ud654 \ud558\uc9c0 \uc54a\uae30"},en:{prayer:"Lord, set a guard over my mouth and let only good words come out.",resolution:"Avoid negative talk or gossip throughout the day."}},{ko:{prayer:"\uc0b6\uc758 \ubaa8\ub4e0 \uc21c\uac04\uc774 \uc8fc\ub2d8\uaed8 \ub4dc\ub824\uc9c0\ub294 \uc608\ubc30\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc77c\ud558\uae30 \uc804 1\ubd84\uac04 \uc8fc\ub2d8\uaed8 \uc624\ub298\uc758 \uc77c\uacfc\ub97c \ub9e1\uaca8\ub4dc\ub9ac\uae30"},en:{prayer:"Let every moment of my life be an act of worship to You.",resolution:"Spend 1 minute entrusting your tasks to God before starting work."}},{ko:{prayer:"\uc9c0\ud61c\uc758 \uadfc\ubcf8\uc774\uc2e0 \uc8fc\ub2d8, \uc624\ub298 \uc81c\uac00 \ub0b4\ub824\uc57c \ud560 \ubaa8\ub4e0 \uacb0\uc815\uc5d0 \uc9c0\ud61c\ub97c \ub354\ud558\uc18c\uc11c.",resolution:"\uc911\uc694\ud55c \uc120\ud0dd\uc744 \ud558\uae30 \uc804\uc5d0 \uc9e7\uac8c\ub77c\ub3c4 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Lord, the source of wisdom, grant me wisdom for every decision I make today.",resolution:"Pray briefly before making any important choices."}},{ko:{prayer:"\uc8fc\ub2d8, \uc5f0\uc57d\ud55c \uc790\ub4e4\uc744 \ub3cc\ubcf4\uc2dc\ub294 \uc8fc\ub2d8\uc758 \ub208\uae38\uc744 \uc800\ub3c4 \ub2ee\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ub9cc\ub098\ub294 \uc18c\uc678\ub41c \uc0ac\ub78c\uc5d0\uac8c \uba3c\uc800 \uc778\uc0ac \uac74\ub124\uae30"},en:{prayer:"Lord, let me see others with Your eyes of compassion for the weak.",resolution:"Greet someone who seems lonely or left out today."}},{ko:{prayer:"\ubcc0\ud568\uc5c6\uc73c\uc2e0 \uc8fc\ub2d8\uc758 \uc0ac\ub791\uc744 \uc758\uc9c0\ud558\uba70, \uc624\ub298\ub3c4 \ud754\ub4e4\ub9ac\uc9c0 \uc54a\ub294 \ubbff\uc74c\uc744 \uc8fc\uc18c\uc11c.",resolution:"\ubd88\uc548\ud55c \ub9c8\uc74c\uc774 \ub4e4 \ub54c\ub9c8\ub2e4 '\uc8fc\ub2d8\uc774 \ub098\uc640 \ud568\uaed8\ud558\uc2e0\ub2e4'\uace0 \uace0\ubc31\ud558\uae30"},en:{prayer:"Relying on Your unchanging love, give me a firm faith today.",resolution:"Declare 'The Lord is with me' whenever you feel anxious."}},{ko:{prayer:"\uc608\uc218\ub2d8\uc758 \uc131\ud488\uc744 \ubcf8\ubc1b\uc544 \uc624\ub298 \ud558\ub8e8\ub3c4 \uc628\uc720\ud558\uace0 \ub530\ub73b\ud558\uac8c \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc6b4\uc804\ud558\uac70\ub098 \uae38\uc744 \uac08 \ub54c \ub2e4\ub978 \uc0ac\ub78c\uc5d0\uac8c \uba3c\uc800 \uc591\ubcf4\ud558\uae30"},en:{prayer:"Help me live gently and warmly today, following the character of Jesus.",resolution:"Give way to others while driving or walking today."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \uac00\uc9c4 \uac83\uc5d0 \uc790\uc871\ud558\uba70 \uc8fc\uc2e0 \ubcf5\uc744 \uc138\uc5b4\ubcf4\ub294 \ud558\ub8e8\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \ub098\uc5d0\uac8c \uc788\ub294 \uac83 5\uac00\uc9c0\ub97c \uc801\uc5b4\ubcf4\uace0 \uac10\uc0ac\ud558\uae30"},en:{prayer:"Lord, let me be content with what I have and count the blessings You've given.",resolution:"List 5 things you have and give thanks for them today."}},{ko:{prayer:"\uc5b4\ub460 \uc18d\uc5d0\uc11c\ub3c4 \uae38\uc744 \ub0b4\uc2dc\ub294 \uc8fc\ub2d8, \uc81c \uc0b6\uc758 \uc9c4\uc815\ud55c \uc8fc\uad8c\uc790\uac00 \ub418\uc5b4 \uc8fc\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \uc77c\uc5b4\ub098\ub294 \ubaa8\ub4e0 \uc77c\uc744 \ubd88\ud3c9 \uc5c6\uc774 \ubc1b\uc544\ub4e4\uc774\uae30"},en:{prayer:"Lord who makes a way in the dark, be the true Sovereign of my life.",resolution:"Accept everything that happens today without complaining."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uc601\ud63c\uc774 \uc8fc\ub97c \uc559\ub9dd\ud558\uba70 \uc0c8 \ud798\uc744 \uc5bb\ub294 \ud558\ub8e8\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc810\uc2ec\uc2dc\uac04\uc774\ub098 \ud734\uc2dd \uc2dc\uac04\uc5d0 5\ubd84\uac04 \uc870\uc6a9\ud788 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Lord, let my soul look to You and gain new strength today.",resolution:"Spend 5 minutes in quiet prayer during lunch or a break."}},{ko:{prayer:"\uc9c4\ub9ac\uc758 \uc601\uc774\uc2e0 \uc8fc\ub2d8, \ub9d0\uc500\uc774 \uc81c \uc0b6\uc758 \uae30\uc900\uc774 \ub418\uace0 \ubc29\ud5a5\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \uc77d\uc740 \ub9d0\uc500\uc744 \ud55c \ubc88 \ub354 \uc554\uc1a1\ud558\uba70 \ubb35\uc0c1\ud558\uae30"},en:{prayer:"Lord, the Spirit of Truth, let Your Word be the standard and direction of my life.",resolution:"Recite and meditate on today's verse once more."}},{ko:{prayer:"\uce58\uc720\ud558\uc2dc\ub294 \uc8fc\ub2d8, \uc81c \ub9c8\uc74c\uc758 \uc0c1\ucc98\ub97c \uc5b4\ub8e8\ub9cc\uc838 \uc8fc\uc2dc\uace0 \uc6a9\uc11c\ud560 \ub9c8\uc74c\uc744 \uc8fc\uc18c\uc11c.",resolution:"\ub098\ub97c \ud798\ub4e4\uac8c \ud588\ub358 \uc0ac\ub78c\uc744 \uc704\ud574 \uc9e7\uac8c \ucd95\ubcf5 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Healing Lord, touch the wounds in my heart and give me a heart to forgive.",resolution:"Say a short prayer of blessing for someone who has hurt you."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uc0b6\uc774 \uc8fc\ub2d8\uc758 \uc120\ud558\uc2ec\uc744 \ub4dc\ub7ec\ub0b4\ub294 \ud5a5\uae30\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4 \uc8fc\ubcc0\uc744 \uae68\ub057\ud558\uac8c \uc815\ub9ac\ud558\uba70 \uc8fc\ub2d8\uc758 \uc9c8\uc11c\ub97c \uc5f0\uc2b5\ud558\uae30"},en:{prayer:"Lord, let my life be a fragrance revealing Your goodness.",resolution:"Practice God's order by tidying up your surroundings today."}},{ko:{prayer:"\uacf5\uae09\ud558\uc2dc\ub294 \uc8fc\ub2d8, \uc624\ub298\ub3c4 \uc77c\uc6a9\ud560 \uc591\uc2dd\uacfc \ud544\uc694\ud55c \ubaa8\ub4e0 \uac83\uc744 \ucc44\uc6cc\uc8fc\uc2ec\uc5d0 \uac10\uc0ac\ud569\ub2c8\ub2e4.",resolution:"\uc2dd\uc0ac\ud560 \ub54c\ub9c8\ub2e4 \uc9c4\uc2ec\uc744 \ub2f4\uc544 \uac10\uc0ac\uc758 \uae30\ub3c4 \ub4dc\ub9ac\uae30"},en:{prayer:"Providing Lord, thank You for filling my daily bread and all my needs today.",resolution:"Offer a sincere prayer of thanks before every meal."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \uc815\uc9c1\ud558\uace0 \uc131\uc2e4\ud558\uac8c \uc624\ub298 \ud558\ub8e8\ub97c \uc0b4\uc544\uac00\ub3c4\ub85d \ub3c4\uc640\uc8fc\uc18c\uc11c.",resolution:"\uc791\uc740 \uc77c\uc774\ub77c\ub3c4 \uc18d\uc784 \uc5c6\uc774 \uc815\uc9c1\ud558\uac8c \ucc98\ub9ac\ud558\uae30"},en:{prayer:"Lord, help me live this day with honesty and integrity.",resolution:"Handle even small tasks with honesty and without deception."}},{ko:{prayer:"\ud3c9\uac15\uc758 \uc544\ub4e4\uc774\uc2e0 \uc608\uc218\ub2d8, \uc81c \uac00\uc815\uacfc \uc77c\ud130\uc5d0 \uc8fc\ub2d8\uc758 \ud3c9\ud654\ub97c \ubd80\uc5b4 \uc8fc\uc18c\uc11c.",resolution:"\uac00\uc871\uc774\ub098 \ub3d9\ub8cc\uc5d0\uac8c '\uc0ac\ub791\ud569\ub2c8\ub2e4', '\ucd95\ubcf5\ud569\ub2c8\ub2e4'\ub77c\uace0 \ub9d0\ud558\uae30"},en:{prayer:"Jesus, Prince of Peace, pour Your peace into my home and workplace.",resolution:"Say 'I love you' or 'God bless you' to family or colleagues."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \ub9c8\uc74c\uc774 \uc138\uc0c1\uc744 \ud5a5\ud558\uc9c0 \uc54a\uace0 \uc624\uc9c1 \uc8fc\ub2d8\uaed8 \uace0\uc815\ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc7a0\ub4e4\uae30 \uc804 \uc624\ub298 \ud558\ub8e8 \ud568\uaed8\ud558\uc2e0 \uc8fc\ub2d8\uaed8 \uac10\uc0ac \uace0\ubc31\ud558\uae30"},en:{prayer:"Lord, let my heart not turn toward the world but be fixed only on You.",resolution:"Confess your gratitude to God for being with you before sleeping."}},{ko:{prayer:"\uad11\uc57c\uc5d0\uc11c\ub3c4 \uae38\uc744 \ub0b4\uc2dc\ub294 \uc8fc\ub2d8, \ub9c9\ub9c9\ud55c \uc0c1\ud669 \uc18d\uc5d0\uc11c \uc8fc\ub97c \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\ubb38\uc81c\uac00 \uc0dd\uacbc\uc744 \ub54c \uac71\uc815\ubcf4\ub2e4 '\ud558\ub098\ub2d8 \ub3c4\uc640\uc8fc\uc138\uc694'\ub77c\uace0 \uba3c\uc800 \ub9d0\ud558\uae30"},en:{prayer:"Lord who makes a road in the wilderness, let me see You in confusing times.",resolution:"Say 'God, help me' first instead of worrying when problems arise."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uc0b6\uc758 \ubaa8\ub4e0 \uc601\uc5ed\uc5d0\uc11c \uc8fc\ub2d8\uc774 \uc8fc\uc778\uc774\uc2ec\uc744 \uc778\uc815\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\uc758 \uacc4\ud68d\ubcf4\ub2e4 \uc8fc\ub2d8\uc758 \uc778\ub3c4\ud558\uc2ec\uc744 \uc6b0\uc120\uc21c\uc704\uc5d0 \ub450\uae30"},en:{prayer:"Lord, help me acknowledge Your Lordship in every area of my life.",resolution:"Prioritize God's guidance over your own plans today."}},{ko:{prayer:"\uc120\ud55c \ubaa9\uc790 \ub418\uc2e0 \uc8fc\ub2d8, \uc800\ub97c \ud478\ub978 \ud480\ubc2d\uacfc \uc274 \ub9cc\ud55c \ubb3c\uac00\ub85c \uc778\ub3c4\ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \ubc14\uc05c \uc77c\uc0c1 \uc18d\uc5d0\uc11c \uc8fc\ub2d8\uacfc \ub3d9\ud589\ud568\uc744 \uae30\uc5b5\ud558\uae30"},en:{prayer:"Lord, my Good Shepherd, lead me to green pastures and still waters.",resolution:"Remember God's presence even in the midst of a busy day."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac8c \uac74\uac15\uacfc \uc9c0\ud61c\ub97c \uc8fc\uc154\uc11c \ub9e1\uaca8\uc9c4 \uc0ac\uba85\uc744 \uc798 \uac10\ub2f9\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\uc758 \ubab8\uacfc \ub9c8\uc74c\uc744 \uadc0\ud558\uac8c \uc5ec\uae30\uba70 \uac74\uac15\ud55c \uc2b5\uad00 \ud558\ub098 \uc2e4\ucc9c\ud558\uae30"},en:{prayer:"Lord, give me health and wisdom to fulfill the mission entrusted to me.",resolution:"Value your body and mind by practicing one healthy habit today."}},{ko:{prayer:"\uc628 \uc6b0\uc8fc\uc758 \uc655\uc774\uc2e0 \uc8fc\ub2d8, \uc624\ub298 \uc81c \uc0b6\uc744 \uc628\uc804\ud788 \ud1b5\uce58\ud558\uc5ec \uc8fc\uc18c\uc11c.",resolution:"\ubaa8\ub4e0 \uc77c\uc5d0 \uc8fc\ub2d8\uc758 \uc601\uad11\uc744 \uac00\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ud589\ub3d9\ud558\uae30"},en:{prayer:"Lord, King of the Universe, rule over my life completely today.",resolution:"Act in a way that does not overshadow the glory of God in everything."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \ubbff\uc74c\uc774 \uc790\ub77c\ub098\uac8c \ud558\uc2dc\uace0 \uc8fc\ub2d8\uacfc \ub354 \uae4a\uc740 \uad50\uc81c\ub97c \ub204\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \uc77d\uc740 \ub9d0\uc500\uc744 \uc8fc\ubcc0 \uc0ac\ub78c 1\uba85\uc5d0\uac8c \uacf5\uc720\ud558\uae30"},en:{prayer:"Lord, let my faith grow and help me enjoy deeper fellowship with You.",resolution:"Share today's verse with at least one person around you."}},{ko:{prayer:"\ud56d\uc0c1 \uc751\ub2f5\ud558\uc2dc\ub294 \uc8fc\ub2d8, \ub099\uc2ec\ud558\uc9c0 \uc54a\uace0 \ub05d\uae4c\uc9c0 \uae30\ub3c4\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ud3ec\uae30\ud558\uace0 \uc2f6\uc5c8\ub358 \uae30\ub3c4 \uc81c\ubaa9\uc744 \ub2e4\uc2dc \ud55c\ubc88 \uac04\uc808\ud788 \uc544\ub8b0\uae30"},en:{prayer:"Lord who always answers, help me pray persistently without losing heart.",resolution:"Earnestly pray once more for the topic I felt like giving up on."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \ub9c8\uc74c\uc758 \uc774\uc6c3\uc744 \uc0ac\ub791\ud558\ub294 \ub9c8\uc74c\uc774 \uc2dd\uc9c0 \uc54a\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ub0b4 \uc8fc\ubcc0\uc758 \uc774\uc6c3\uc5d0\uac8c \uc791\uc740 \uce5c\uc808 \ubca0\ud480\uae30"},en:{prayer:"Lord, let not the love for my neighbors cool down in my heart.",resolution:"Show a small act of kindness to a neighbor today."}},{ko:{prayer:"\uc131\ub839\uc758 \uc5f4\ub9e4\uac00 \uc81c \uc0b6 \uc18d\uc5d0\uc11c \ud48d\uc131\ud788 \ub9fa\ud788\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ud558\ub8e8 \uc0ac\ub791, \ud76c\ub77d, \ud654\ud3c9\uc758 \ub9c8\uc74c\uc744 \uc720\uc9c0\ud558\ub824 \ub178\ub825\ud558\uae30"},en:{prayer:"Let the fruit of the Spirit be abundant in my life.",resolution:"Try to maintain a heart of love, joy, and peace throughout today."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \uc804\uc2e0\uac11\uc8fc\ub97c \uc785\uace0 \uc138\uc0c1\uc758 \uc720\ud639\uc744 \ub109\ub109\ud788 \uc774\uae30\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\ub97c \uc720\ud639\ud558\ub824\ub294 \ud658\uacbd\uc5d0\uc11c \uc989\uc2dc \uba40\uc5b4\uc9c0\uae30\ub85c \uacb0\ub2e8\ud558\uae30"},en:{prayer:"Put on the full armor of God to overcome the world's temptations.",resolution:"Decide to immediately distance yourself from tempting environments."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \uc5b4\ub460 \uc18d\uc5d0\uc11c\ub3c4 \ube5b\uc744 \ub0b4\ub294 \uc790\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc6b0\uc6b8\ud558\uac70\ub098 \ubd80\uc815\uc801\uc778 \ubd84\uc704\uae30\ub97c \ucf8c\ud65c\ud558\uac8c \ubc14\uafd4\ubcf4\uae30"},en:{prayer:"Lord, let me be one who shines even in the darkness.",resolution:"Try to change a gloomy or negative atmosphere into a cheerful one."}},{ko:{prayer:"\uc778\ub0b4\uc758 \uc8fc\ub2d8, \uc81c\uac00 \uc11c\ub450\ub974\uc9c0 \uc54a\uace0 \uc8fc\ub2d8\uc758 \ub54c\ub97c \uae30\ub2e4\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\uae30\ub2e4\ub824\uc57c \ud558\ub294 \uc0c1\ud669\uc5d0\uc11c \uc9dc\uc99d \ub300\uc2e0 \uae30\ub3c4\ub85c \uc774\uaca8\ub0b4\uae30"},en:{prayer:"Patient Lord, help me wait for Your timing without rushing.",resolution:"Overcome situations that require waiting with prayer instead of irritation."}},{ko:{prayer:"\uc808\uc81c\ud558\ub294 \ub9c8\uc74c\uc744 \uc8fc\uc154\uc11c \uc81c \uc0b6\uc758 \uc6b0\uc120\uc21c\uc704\ub97c \ubc14\ub85c \uc138\uc6b0\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \uc1fc\ud551\uc774\ub098 \ubd88\ud544\uc694\ud55c \uc18c\ube44\ub97c \ud55c \ubc88 \ucc38\uc544\ubcf4\uae30"},en:{prayer:"Give me a heart of self-control to set my life's priorities right.",resolution:"Refrain from unnecessary shopping or spending today."}},{ko:{prayer:"\uace0\ub09c \uc911\uc5d0\ub3c4 \uc8fc\ub2d8\uc744 \ucc2c\uc591\ud560 \uc218 \uc788\ub294 \ubbff\uc74c\uc744 \ub354\ud558\uc18c\uc11c.",resolution:"\ud798\ub4e0 \uc77c\uc774 \uc0dd\uae38 \ub54c \uac00\uc7a5 \uba3c\uc800 \ucc2c\uc591 \ud55c \uace1 \ubd80\ub974\uae30"},en:{prayer:"Grant me faith to praise the Lord even in the midst of suffering.",resolution:"Sing a song of praise first whenever a difficult task arises."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \ub098\ub77c\uc640 \uc758\ub97c \uba3c\uc800 \uad6c\ud558\ub294 \uc0b6\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4 \uc720\uc775\ubcf4\ub2e4 \ud558\ub098\ub2d8\uc758 \uc601\uad11\uc774 \ub418\ub294 \uae38\uc744 \uc120\ud0dd\ud558\uae30"},en:{prayer:"Let my life be one that seeks first the kingdom of God and His righteousness.",resolution:"Choose the path that glorifies God over your own interests."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \ub9d0\uc500\uc774 \uc81c \ubc1c\uc758 \ub4f1\uc774\uc694 \uc81c \uae38\uc758 \ube5b\uc774 \ub428\uc744 \uc120\ud3ec\ud569\ub2c8\ub2e4.",resolution:"\uc624\ub298 \ud558\ub8e8\uc758 \uacc4\ud68d\uc744 \ub9d0\uc500\uc758 \uac00\uce58\uad00\uc5d0 \ube44\ucd94\uc5b4 \uc810\uac80\ud558\uae30"},en:{prayer:"I declare that Your Word is a lamp to my feet and a light to my path.",resolution:"Check today's plans against the values of the Word."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac8c \uc5f4\ubc29\uc744 \ud5a5\ud55c \uc8fc\ub2d8\uc758 \ub9c8\uc74c\uc744 \ubd80\uc5b4 \uc8fc\uc18c\uc11c.",resolution:"\uc138\uacc4\uc758 \ubcf5\uc74c\ud654\ub97c \uc704\ud574, \ud639\uc740 \ud2b9\uc815 \uc120\uad50\uc9c0\ub97c \uc704\ud574 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Lord, pour Your heart for the nations into me.",resolution:"Pray for world evangelization or a specific mission field."}},{ko:{prayer:"\uccad\ub144\uacfc \uac19\uc740 \ud798\uc744 \uc8fc\uc154\uc11c \uc8fc\ub2d8\uc758 \uc77c\uc744 \uae30\uc068\uc73c\ub85c \uac10\ub2f9\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\ud0dc\ud574\uc9c0\ub824\ub294 \ub9c8\uc74c\uc744 \ud138\uc5b4\ub0b4\uace0 \ud65c\uae30\ucc28\uac8c \uc5c5\ubb34\uc5d0 \uc784\ud558\uae30"},en:{prayer:"Give me strength like that of a youth to do Your work with joy.",resolution:"Shake off lethargy and approach your work with vigor."}},{ko:{prayer:"\uc5f0\ub95c\uc5d0 \ub9de\ub294 \uc9c0\ud61c\ub97c \uc8fc\uc154\uc11c \uacf5\ub3d9\uccb4\uc758 \ubcf8\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ud6c4\ubc30\ub098 \ub3d9\uc0dd\ub4e4\uc5d0\uac8c \ub530\ub73b\ud55c \uaca9\ub824\uc758 \ub9d0 \uac74\ub124\uae30"},en:{prayer:"Give me wisdom appropriate for my years to be an example to the community.",resolution:"Give warm words of encouragement to juniors or younger siblings."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uac00\uc815\uc774 \uc8fc\ub2d8\uc744 \uacbd\uc678\ud558\ub294 \ubbff\uc74c\uc758 \uba85\ubb38\uac00\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uac00\uc871 \ud55c \uc0ac\ub78c \ud55c \uc0ac\ub78c\uc758 \uc774\ub984\uc744 \ubd80\ub974\uba70 \ucd95\ubcf5 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Lord, let my family be a noble house of faith that fears the Lord.",resolution:"Pray a blessing for each family member by name."}},{ko:{prayer:"\uad50\ud68c\ub97c \uc0ac\ub791\ud558\ub294 \ub9c8\uc74c\uc744 \uc8fc\uc154\uc11c \uc9c0\uccb4\ub4e4\uc744 \uc9c4\uc2ec\uc73c\ub85c \uc12c\uae30\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\uc758 \uc740\uc0ac\ub85c \uad50\ud68c\ub97c \uc704\ud574 \ubd09\uc0ac\ud560 \uc218 \uc788\ub294 \uc601\uc5ed \ucc3e\uc544\ubcf4\uae30"},en:{prayer:"Give me a heart that loves the church to sincerely serve the members.",resolution:"Find an area where I can serve the church with my gifts."}},{ko:{prayer:"\uc791\uc740 \uc77c\uc5d0 \ucda9\uc131\ud558\ub294 \uc790\ub97c \ud06c\uac8c \uc4f0\uc2dc\ub294 \uc8fc\ub2d8\uc744 \ucc2c\uc591\ud569\ub2c8\ub2e4.",resolution:"\ub0a8\uc774 \ubcf4\uc9c0 \uc54a\ub294 \uacf3\uc5d0\uc11c\ub3c4 \ucd5c\uc120\uc744 \ub2e4\ud574 \uc624\ub298 \uc9c1\ubb34 \uc131\ucde8\ud558\uae30"},en:{prayer:"Praise the Lord who uses those who are faithful in small things.",resolution:"Do your best to achieve today's duties even when no one is watching."}},{ko:{prayer:"\uc8fc\ub2d8 \ud488 \uc548\uc5d0\uc11c \uc9c4\uc815\ud55c \uc548\uc2dd\uacfc \uc27c\uc744 \ub204\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\ub108\ubb34 \ubc14\ube60\uc11c \ub193\ucce4\ub358 '\uc27c'\uc758 \uc2dc\uac04\uc744 \ud558\ub098\ub2d8\uacfc \ud568\uaed8 \uac16\uae30"},en:{prayer:"Let me enjoy true rest and relaxation within Your embrace.",resolution:"Take time for 'rest' with God that you missed due to being too busy."}},{ko:{prayer:"\uc8fc\ub2d8\uc774 \uc8fc\uc2dc\ub294 \ub2f4\ub300\ud568\uc73c\ub85c \ub450\ub824\uc6c0\uc744 \ubb3c\ub9ac\uce58\uac8c \ud558\uc18c\uc11c.",resolution:"\ub450\ub824\uc6e0\ub358 \ub3c4\uc804\uc744 \ubbff\uc74c\uc73c\ub85c \ud55c \ubc88 \ub354 \uc2dc\ub3c4\ud574 \ubcf4\uae30"},en:{prayer:"Banish fear with the boldness that comes from the Lord.",resolution:"Try once more a daunting challenge with faith."}},{ko:{prayer:"\uc608\uc218 \ubcf4\ud608\uc758 \ub2a5\ub825\uc744 \uc758\uc9c0\ud558\uba70 \uc8c4\uc640 \uc2f8\uc6cc \uc774\uae30\uac8c \ud558\uc18c\uc11c.",resolution:"\ubc18\ubcf5\ub418\ub358 \ub098\uc05c \uc2b5\uad00\uc744 \ub04a\uc5b4\ub0b4\uaca0\ub2e4\ub294 \uacb0\ub2e8\ud558\uae30"},en:{prayer:"Relying on the power of Jesus' blood, help me overcome sin.",resolution:"Decide to break away from recurring bad habits."}},{ko:{prayer:"\uc131\ub839\ub2d8, \uc624\ub298\ub3c4 \uc81c \uc0dd\uac01\uc744 \uc8fc\uad00\ud558\uc2dc\uace0 \uac08 \uae38\uc744 \ubcf4\uc5ec \uc8fc\uc18c\uc11c.",resolution:"\uc790\uc2e0\uc758 \uc0dd\uac01\ubcf4\ub2e4 \uc131\ub839\ub2d8\uc758 \uc138\ubc00\ud55c \uc74c\uc131\uc5d0 \uadc0 \uae30\uc6b8\uc774\uae30"},en:{prayer:"Holy Spirit, guide my thoughts and show me the way today.",resolution:"Listen to the Holy Spirit's still, small voice over your own thoughts."}},{ko:{prayer:"\uadf8\ub9ac\uc2a4\ub3c4 \uc548\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud53c\uc870\ubb3c\uc774 \ub418\uc5c8\uc74c\uc744 \uac10\uc0ac\ud558\uba70 \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\uacfc\uac70\uc758 \ud6c4\ud68c\uc5d0\uc11c \ubc97\uc5b4\ub098 '\uc624\ub298'\uc744 \uc8fc\uc2e0 \ud558\ub098\ub2d8\uaed8 \uac10\uc0ac\ud558\uae30"},en:{prayer:"Help me live with gratitude that I've become a new creation in Christ.",resolution:"Let go of past regrets and thank God for giving you 'today'."}},{ko:{prayer:"\ucc38\ud3ec\ub3c4\ub098\ubb34 \ub418\uc2e0 \uc8fc\ub2d8\uaed8 \ubd99\uc5b4 \uc788\uc5b4 \ub9ce\uc740 \uc5f4\ub9e4\ub97c \ub9fa\uac8c \ud558\uc18c\uc11c.",resolution:"\uc8fc\ub2d8\uacfc \ub5a8\uc5b4\uc838\uc11c \ub0b4 \ud798\uc73c\ub85c \ud558\ub824 \ud588\ub358 \uace0\uc9d1 \ub0b4\ub824\ub193\uae30"},en:{prayer:"Abide in the True Vine, the Lord, to bear much fruit.",resolution:"Lay down the stubbornness of trying to do things on your own apart from God."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \ubbff\uc74c\uc758 \uc120\ud55c \uc2f8\uc6c0\uc744 \ub05d\uae4c\uc9c0 \uc2f8\uc6b0\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ubc8c\uc5b4\uc9c0\ub294 \uc601\uc801 \uc804\uc7c1\uc5d0\uc11c \uae30\ub3c4\ub85c \uc2b9\ub9ac\ud558\uae30"},en:{prayer:"Lord, let me fight the good fight of faith to the end.",resolution:"Win the spiritual battles that occur today through prayer."}},{ko:{prayer:"\uc774 \ub545\uc758 \uac83\uc774 \uc544\ub2cc \ud558\ub298\uc758 \uc18c\ub9dd\uc744 \ud488\uace0 \uc0b4\uc544\uac00\uac8c \ud558\uc18c\uc11c.",resolution:"\uc138\uc0c1\uc758 \uac00\uce58\uc640 \ud558\ub098\ub2d8\uc758 \uac00\uce58\uac00 \ucda9\ub3cc\ud560 \ub54c \ud558\ub298\uc758 \uac83\uc744 \ud0dd\ud558\uae30"},en:{prayer:"Help me live with heavenly hope, not focusing on earthly things.",resolution:"Choose heavenly values when they conflict with worldly values."}},{ko:{prayer:"\uc8fc\uc2e0 \uc2dc\uac04\uacfc \ubb3c\uc9c8\uc744 \uc9c0\ud61c\ub86d\uac8c \uad00\ub9ac\ud558\ub294 \uc120\ud55c \uccad\uc9c0\uae30\uac00 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ub098\uc5d0\uac8c \uc8fc\uc5b4\uc9c4 \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\uace0 \uc18c\uc911\ud788 \uc4f0\uae30"},en:{prayer:"Be a good steward who wisely manages time and resources given.",resolution:"Use the resources given to you today carefully without wasting them."}},{ko:{prayer:"\uc8fc\ub2d8\uc744 \uc704\ud574 \uc81c \uc0b6\uc758 \uc625\ud569\uc744 \uae68\ub728\ub9ac\ub294 \ud5cc\uc2e0\uc744 \ub4dc\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4\uac00 \uac00\uc7a5 \uc544\ub07c\ub294 \uac83\uc744 \ud558\ub098\ub2d8\uc744 \uc704\ud574 \uae30\uaebc\uc774 \ub0b4\uc5b4\ub4dc\ub9ac\uae30"},en:{prayer:"Let me offer a devotion that breaks my alabaster jar for You.",resolution:"Willingly give up what you cherish most for God."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \ub2e4\ub978 \uc774\ub4e4\uc744 \uc704\ud574 \uc911\ubcf4\ud558\ub294 \uc81c\uc0ac\uc7a5\uc758 \uc0b6\uc744 \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc544\ud508 \uc9c0\uccb4\ub098 \uace0\ub09c\ubc1b\ub294 \uac00\uc815\uc744 \uc704\ud574 \ub9c8\uc74c\uc744 \ub2e4\ud574 \uae30\ub3c4\ud558\uae30"},en:{prayer:"Lord, let me live the life of a priest interceding for others.",resolution:"Pray with all your heart for members in pain or families in suffering."}},{ko:{prayer:"\uc81c \uc601\uc801 \uc131\uc7a5\uc774 \uba48\ucd94\uc9c0 \uc54a\uace0 \uc8fc\ub2d8\uc744 \ub2ee\uc544\uac00\ub294 \uae30\uc068\uc744 \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298\ubcf4\ub2e4 \ub0b4\uc77c \ub354 \uc8fc\ub2d8\uc744 \uc0ac\ub791\ud558\uae30\ub85c \uc57d\uc18d\ud558\uae30"},en:{prayer:"Let my spiritual growth not stop and see the joy of becoming like You.",resolution:"Promise to love the Lord more tomorrow than today."}},{ko:{prayer:"\uc8fc\ub2d8 \uc548\uc5d0\uc11c \uc6b0\ub9ac \uacf5\ub3d9\uccb4\uac00 \uc0ac\ub791\uc73c\ub85c \ud558\ub098 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ube44\ud310\ud558\ub294 \ub9c8\uc74c\uc744 \ubc84\ub9ac\uace0 \ud615\uc81c\ub97c \uc6a9\ub0a9\ud558\uba70 \uae30\ub3c4\ub85c \ud558\ub098 \ub418\uae30"},en:{prayer:"Let our community be one in love through the Lord.",resolution:"Discard critical thoughts, accept brethren, and be united in prayer."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \ub9c8\uc74c\uc744 \uc815\uacb0\ud558\uac8c \ud558\uc2dc\uace0 \uc624\uc9c1 \uc8fc\ub9cc \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4 \ub9c8\uc74c\uc758 \ubcf5\uc7a1\ud55c \uc0dd\uac01\ub4e4\uc744 \uc8fc\ub2d8 \uc55e\uc5d0 \ub0b4\ub824\ub193\uace0 \ub2e8\uc21c\ud574\uc9c0\uae30"},en:{prayer:"Lord, purify my heart and let me see only You.",resolution:"Lay down complex thoughts and become simple before the Lord."}},{ko:{prayer:"\uc9c4\ub9ac\uc758 \ud5c8\ub9ac\ub760\ub97c \ub760\uace0 \ud558\ub098\ub2d8\uc758 \uc9c4\ub9ac \uc704\uc5d0 \uad73\uac74\ud788 \uc11c\uac8c \ud558\uc18c\uc11c.",resolution:"\uc138\uc0c1\uc758 \uac70\uc9d3\ub41c \uac00\uce58\uc5d0 \uc18d\uc9c0 \uc54a\uaca0\ub2e4\uace0 \ub2e4\uc2dc \ud55c\ubc88 \ub2e4\uc9d0\ud558\uae30"},en:{prayer:"Gird yourself with the belt of truth and stand firm on God's truth.",resolution:"Resolve once again not to be deceived by the world's false values."}},{ko:{prayer:"\uc758\uc758 \ud638\uc2ec\uacbd\uc744 \ubd99\uc774\uace0 \uc0ac\ub2e8\uc758 \ubaa8\ub4e0 \uc815\uc8c4\ub97c \uc774\uaca8\ub0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\ub294 \uadf8\ub9ac\uc2a4\ub3c4 \uc548\uc5d0\uc11c \uc758\uc778\uc784\uc744 \ub2f9\ub2f9\ud788 \uc120\ud3ec\ud558\uba70 \uc0b4\uae30"},en:{prayer:"Put on the breastplate of righteousness and overcome all of Satan's condemnation.",resolution:"Live confidently, declaring that you are righteous in Christ."}},{ko:{prayer:"\ud3c9\uc548\uc758 \ubcf5\uc74c\uc774 \uc608\ube44\ud55c \uc2e0\uc744 \uc2e0\uace0 \uc5b4\ub514\ub4e0 \uc8fc\uc640 \ud568\uaed8 \uac00\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4\uac00 \uac00\ub294 \ubaa8\ub4e0 \uacf3\uc5d0 \uc8fc\ub2d8\uc758 \ud3c9\ud654\ub97c \uc804\ud558\uba70 \uac77\uae30"},en:{prayer:"Put on the shoes of the preparation of the gospel of peace and go anywhere with the Lord.",resolution:"Walk spreading the peace of the Lord wherever you go."}},{ko:{prayer:"\ubbff\uc74c\uc758 \ubc29\ud328\ub97c \ub4e4\uc5b4 \uc138\uc0c1\uc758 \ubaa8\ub4e0 \ubd88\ud654\uc0b4\uc744 \uc18c\uba78\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\uc758\uc2ec\uc758 \uad6c\ub984\uc774 \ubab0\ub824\uc62c \ub54c\ub9c8\ub2e4 \ud558\ub098\ub2d8\uc758 \uc57d\uc18d\uc744 \ubd99\uc7a1\uae30"},en:{prayer:"Take the shield of faith to extinguish all the flaming arrows of the world.",resolution:"Hold onto God's promises whenever clouds of doubt move in."}},{ko:{prayer:"\uad6c\uc6d0\uc758 \ud22c\uad6c\ub97c \uc4f0\uace0 \uc81c \uc0dd\uac01\uacfc \ub9c8\uc74c\uc744 \uc8fc\ub2d8\uaed8 \uc628\uc804\ud788 \ub9e1\uae41\ub2c8\ub2e4.",resolution:"\ub0b4 \uad6c\uc6d0\uc740 \ud558\ub098\ub2d8\uaed8\ub9cc \uc788\uc74c\uc744 \uc78a\uc9c0 \uc54a\uace0 \uac10\uc0ac\ud558\uae30"},en:{prayer:"Put on the helmet of salvation and fully entrust my thoughts and heart to You.",resolution:"Do not forget and be thankful that salvation is in God alone."}},{ko:{prayer:"\uc131\ub839\uc758 \uac80, \uace7 \ud558\ub098\ub2d8\uc758 \ub9d0\uc500\uc744 \uc81c \uc190\uc5d0 \uc950\uc5ec \uc8fc\uc2dc\uc635\uc18c\uc11c.",resolution:"\ub9d0\uc500\uc73c\ub85c \ub098\ub97c \uacf5\uaca9\ud558\ub294 \uc720\ud639\ub4e4\uc744 \uac15\ub825\ud788 \ubb3c\ub9ac\uce58\uae30"},en:{prayer:"Put the sword of the Spirit, the Word of God, in my hand.",resolution:"Powerfuly drive out temptations that attack you with the Word."}},{ko:{prayer:"\uc0c8\ubcbd \uc774\uc2ac \uac19\uc740 \ucc2c\uc591\uc73c\ub85c \uc8fc\ub2d8\uaed8 \uc601\uad11 \ub3cc\ub9ac\ub294 \uc544\uce68\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc77c\uc5b4\ub098\uc790\ub9c8\uc790 \uccab \ub9c8\ub514\ub97c \uc8fc\ub2d8\uaed8 '\uc0ac\ub791\ud569\ub2c8\ub2e4'\ub77c\uace0 \uace0\ubc31\ud558\uae30"},en:{prayer:"Let this morning be one that glorifies the Lord with praise like dawn dew.",resolution:"The first thing you say upon waking up, confess 'I love You' to God."}},{ko:{prayer:"\ud558\ub8e8\ub97c \ub9c8\uac10\ud558\uba70 \uc81c \ubaa8\ub4e0 \uc0b6\uc758 \ud754\uc801 \uc18d\uc5d0 \ud568\uaed8\ud558\uc2e0 \uc8fc\ub2d8\uc744 \ucc2c\uc591\ud569\ub2c8\ub2e4.",resolution:"\uc624\ub298 \ud558\ub8e8\uc758 \uc2e4\uc218\ub098 \uc544\uc26c\uc6c0\uc744 \uc2ed\uc790\uac00 \uc55e\uc5d0 \ub0b4\ub824\ub193\uace0 \ud3c9\uc548\ud788 \uc7a0\ub4e4\uae30"},en:{prayer:"Closing the day, I praise the Lord for being present in all the traces of my life.",resolution:"Lay down today's mistakes or regrets before the cross and sleep in peace."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \ub54c\ub97c \uae30\ub2e4\ub9ac\uba70 \uc778\ub0b4\ud558\ub294 \uc790\uc5d0\uac8c \ubcf5\uc744 \uc8fc\uc2dc\ub294 \ud558\ub098\ub2d8\uc744 \uc2e0\ub8b0\ud569\ub2c8\ub2e4.",resolution:"\ub0b4 \ub73b\ub300\ub85c \ub418\uc9c0 \uc54a\ub294 \uc0c1\ud669\uc5d0\uc11c\ub3c4 \ud558\ub098\ub2d8\uc758 \uc120\ud558\uc2ec\uc744 \uc758\uc2ec\ud558\uc9c0 \uc54a\uae30"},en:{prayer:"I trust God who blesses those who patiently wait for His timing.",resolution:"Do not doubt God's goodness even when things don't go your way."}},{ko:{prayer:"\uc624\ub298 \uc81c \uc0b6\uc758 \ub2eb\ud78c \ubb38 \uc55e\uc5d0\uc11c \ub099\uc2ec\ud558\uc9c0 \uc54a\uace0, \uc5f4\ub9b0 \ubb38\uc744 \uae30\ub2e4\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\ud3ec\uae30\ud588\ub358 \uae30\ub3c4\uac00 \uc0c8\ub85c\uc6b4 \ud558\ub098\ub2d8\uc758 \ubc29\ubc95\uc73c\ub85c \uc5f4\ub9b4 \uac83\uc744 \uae30\ub300\ud558\uae30"},en:{prayer:"Lord, let me not be discouraged before the closed doors skip, and wait for the open ones.",resolution:"Expect that previously abandoned prayers will open in God's new way."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \uc8fc\ub2d8\uc758 \ub73b\uc744 \ub530\ub974\ub294 \ub370 \uc788\uc5b4\uc11c \ub450 \ub9c8\uc74c\uc744 \ud488\uc9c0 \uc54a\uac8c \ud558\uc18c\uc11c.",resolution:"\ud558\ub098\ub2d8\uacfc \uc138\uc0c1 \uc0ac\uc774\uc5d0\uc11c \uba38\ubb47\uac70\ub9ac\uc9c0 \uc54a\uace0 \uc624\uc9c1 \uc8fc\ub97c \ud0dd\ud558\uae30"},en:{prayer:"Lord, let me not be double-minded in following Your will.",resolution:"Choose only the Lord without wavering between God and the world."}},{ko:{prayer:"\ub0ae\uc740 \uc790\ub97c \ub192\uc774\uc2dc\ub294 \uc8fc\ub2d8, \uc81c\uac00 \uacb8\uc190\ud788 \uc8fc\ub2d8\uc758 \uc190 \uc544\ub798 \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\ub97c \ub0b4\uc138\uc6b0\uace0 \uc2f6\uc740 \ub9c8\uc74c\uc774 \ub4e4 \ub54c \ud55c \uac78\uc74c \ubb3c\ub7ec\ub098 \uc8fc\ub2d8\uc744 \ubc14\ub77c\ubcf4\uae30"},en:{prayer:"Lord who exalts the humble, help me live humbly under Your hand.",resolution:"When you want to show off, take a step back and look to the Lord."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c\uac00 \uae30\uaebc\uc774 \ub2e4\ub978 \uc774\uc758 \ubc1c\uc744 \uc53b\uae30\ub294 \uc885\uc758 \ub9c8\uc74c\uc73c\ub85c \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\ub204\uad6c\uc5d0\uac8c\ub4e0 \ub300\uc811\ubc1b\uae30\ubcf4\ub2e4 \uba3c\uc800 \ub300\uc811\ud558\ub294 \ub9c8\uc74c \uac16\uae30"},en:{prayer:"Lord, let me live with the heart of a servant, willingly washing others' feet.",resolution:"Have a heart to serve others first rather than wanting to be served."}},{ko:{prayer:"\uc138\uc0c1\uc758 \ub9db\uc744 \uc783\uc9c0 \uc54a\ub294 \uc18c\uae08\uc73c\ub85c\uc11c \uc8fc\ub2d8\uc758 \ube5b\uc744 \ubc1c\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ubb34\uc758\ubbf8\ud55c \ub9d0\ub4e4\uc744 \uc0bc\uac00\uace0 \uac10\ub3d9\uc744 \uc8fc\ub294 \ud55c \ub9c8\ub514 \uac74\ub124\uae30"},en:{prayer:"Let me shine Your light as salt that doesn't lose its flavor in the world.",resolution:"Refrain from meaningless talk and offer a touch of inspiration."}},{ko:{prayer:"\uc0b0 \uc704\uc758 \ub3d9\ub124\ucc98\ub7fc \uc228\uaca8\uc9c0\uc9c0 \uc54a\ub294 \uc8fc\ub2d8\uc758 \uc601\uad11\uc774 \uc81c \uc0b6\uc5d0 \ud750\ub974\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\uc758 \ud589\ub3d9 \ud558\ub098\uac00 \ub204\uad70\uac00\uc5d0\uac8c \uc8fc\ub2d8\uc758 \uc0b4\uc544\uacc4\uc2ec\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud1b5\ub85c\uac00 \ub418\uae30"},en:{prayer:"Let Your glory flow in my life like a city on a hill that cannot be hidden.",resolution:"Let one of your actions be a channel to show someone that God is alive."}},{ko:{prayer:"\uc9c0\ud61c\ub85c\uc6b4 \uac74\ucd95\uac00\ucc98\ub7fc \ub9d0\uc500\uc758 \ubc18\uc11d \uc704\uc5d0 \uacac\uace0\ud788 \uc9d1\uc744 \uc9d3\uac8c \ud558\uc18c\uc11c.",resolution:"\ud754\ub4e4\ub9ac\ub294 \uc138\uc0c1 \ud48d\uc870\uac00 \uc544\ub2cc \uc624\uc9c1 \uae30\ub85d\ub41c \ub9d0\uc500\uc744 \uc2e0\ub8b0\ud558\uae30"},en:{prayer:"Help me build my house firmly on the rock of the Word like a wise builder.",resolution:"Trust only the written Word, not the unstable trends of the world."}},{ko:{prayer:"\ucc29\ud55c \uc528\uc557\uc744 \ubfcc\ub9ac\ub294 \uc8fc\ub2d8\uc758 \ub18d\ubd80\ub85c\uc11c \uc120\ud589\uc744 \uba48\ucd94\uc9c0 \uc54a\uac8c \ud558\uc18c\uc11c.",resolution:"\ub2f9\uc7a5 \uc5f4\ub9e4\uac00 \ubcf4\uc774\uc9c0 \uc54a\uc544\ub3c4 \uc0ac\ub791\uc758 \uc218\uace0\ub97c \uc544\ub07c\uc9c0 \uc54a\uae30"},en:{prayer:"As the Lord's farmer sowing good seeds, let me not stop doing good.",resolution:"Do not spare the labor of love even if the fruit isn't visible right away."}},{ko:{prayer:"\ud55c \ub9c8\ub9ac\uc758 \uc783\uc740 \uc591\uc744 \ucc3e\uc73c\uc2dc\ub294 \uc8fc\ub2d8\uc758 \uc560\ud1b5\ud55c \ub9c8\uc74c\uc744 \ubd80\uc5b4 \uc8fc\uc18c\uc11c.",resolution:"\uc608\uc218\ub2d8\uc744 \uc54c\uc9c0 \ubabb\ud558\ub294 \uce5c\uad6c\ub098 \uac00\uc871\uc744 \uc704\ud574 \ub208\ubb3c\ub85c \uc911\ubcf4\ud558\uae30"},en:{prayer:"Pour Your grieving heart for searching for one lost sheep into me.",resolution:"Interceed with tears for friends or family who do not know Jesus."}},{ko:{prayer:"\ud0d5\uc790\ub97c \uae30\ub2e4\ub9ac\uc2dc\ub294 \uc544\ubc84\uc9c0\uc758 \ub9c8\uc74c \uadf8 \ub728\uac70\uc6b4 \uc0ac\ub791\uc744 \ubcf8\ubc1b\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\ub97c \ub5a0\ub098\uac70\ub098 \uc0c1\ucc98 \uc900 \uc0ac\ub78c\uc744 \uc815\uc8c4\ud558\uc9c0 \uc54a\uace0 \uae30\ub2e4\ub824 \uc8fc\uae30"},en:{prayer:"Let me follow the warm love of the Father waiting for the prodigal son.",resolution:"Wait for someone who has left or hurt you without condemning them."}},{ko:{prayer:"\uc8fc\ub2d8\uacfc \uc5f0\ud569\ud558\uc5ec \uc8fc\ub2d8\uc758 \uc0dd\uba85\uc774 \uc81c \uc0b6\uc744 \uac00\ub4dd \ucc44\uc6b0\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4 \uc758\uc9c0\ubcf4\ub2e4 \uc8fc\ub2d8\uc758 \uc740\ud61c\uac00 \ub098\ub97c \ub04c\uace0 \uac00\ub3c4\ub85d \uc21c\uc885\ud558\uae30"},en:{prayer:"Be united with the Lord so that Your life fills my life completely.",resolution:"Obey so that His grace leads me rather than my own will."}},{ko:{prayer:"\ucc38\ud3ec\ub3c4\ub098\ubb34\uc774\uc2e0 \uc8fc\ub2d8, \uc81c \uc0b6\uc774 \uc8fc\ub2d8\uaed8 \uc544\ub984\ub2e4\uc6b4 \uc5f4\ub9e4\ub9cc \uc62c\ub824\ub4dc\ub9ac\uac8c \ud558\uc18c\uc11c.",resolution:"\ub0b4 \uc0b6\uc758 \uc5f4\ub9e4\uac00 \uc8fc\ub2d8\uaed8 \uae30\uc068\uc774 \ub418\ub294\uc9c0 \uc2a4\uc2a4\ub85c \ub3cc\uc544\ubcf4\uae30"},en:{prayer:"Lord, the true vine, let my life offer only beautiful fruits to You.",resolution:"Reflect on whether the fruits of your life are pleasing to the Lord."}},{ko:{prayer:"\uc131\ub839\uc758 \uc0ac\ub791\uc758 \uc5f4\ub9e4\ub85c \uc81c \uc8fc\ubcc0\uc774 \ub530\ub73b\ud574\uc9c0\ub294 \uae30\uc801\uc744 \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \uac00\uc7a5 \ubbf8\uc6b4 \uc0ac\ub78c\uc5d0\uac8c \uce5c\uc808\ud55c \ub9d0 \ud55c \ub9c8\ub514 \ub354 \uac74\ub124\uae30"},en:{prayer:"See the miracle of my surroundings warming up with the fruit of Spirit's love.",resolution:"Offer one more kind word to the person you dislike most today."}},{ko:{prayer:"\uae30\uc068\uc758 \uc5f4\ub9e4\ub85c \uc81c \uc0b6\uc758 \ubaa8\ub4e0 \uc6b0\uc6b8\uacfc \uadf8\ub298\uc744 \ubab0\uc544\ub0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \uc77c\uc774\ub098 \ud658\uacbd\uacfc \uad00\uacc4\uc5c6\uc774 \uc8fc\ub2d8 \uc548\uc5d0\uc11c \uc77c\ubd80\ub7ec \uc6c3\uc5b4\ubcf4\uae30"},en:{prayer:"Drive away all depression and shadows in my life with the fruit of joy.",resolution:"Try to smile on purpose in the Lord regardless of work or environment today."}},{ko:{prayer:"\ud654\ud3c9\uc758 \uc5f4\ub9e4\ub85c \uac08\ub4f1\uc774 \uc788\ub294 \uacf3\uc5d0 \ud3c9\ud654\uc758 \uc0ac\uc2e0\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\ub2e4\ud23c\uc774 \uc77c\uc5b4\ub0ac\uc744 \ub54c \uba3c\uc800 \uc0ac\uacfc\ud558\uace0 \ud3c9\ud654\ub97c \uccad\ud558\uae30"},en:{prayer:"Become a messenger of peace in places of conflict with the fruit of peace.",resolution:"Apologize first and ask for peace when a dispute arises."}},{ko:{prayer:"\uc778\ub0b4\uc758 \uc5f4\ub9e4\ub85c \uc8fc\ub2d8\uc758 \uc57d\uc18d\uc774 \uc131\ucde8\ub420 \ub54c\uae4c\uc9c0 \uacac\ub514\uac8c \ud558\uc18c\uc11c.",resolution:"\ud798\ub4e0 \uc0c1\ud669 \uc18d\uc5d0\uc11c\ub3c4 \ub05d\uae4c\uc9c0 \uc6d0\ub9dd\ud558\uc9c0 \uc54a\uace0 \uc8fc\ub2d8 \ubc14\ub77c\ubcf4\uae30"},en:{prayer:"Endure with the fruit of patience until Your promise is fulfilled.",resolution:"Look to the Lord without complaining until the end even in hard situations."}},{ko:{prayer:"\uc790\ube44\uc758 \uc5f4\ub9e4\ub85c \uae0d\ud73c\uc774 \ud544\uc694\ud55c \uc790\ub4e4\uc744 \ubd88\uc30d\ud788 \uc5ec\uae30\uac8c \ud558\uc18c\uc11c.",resolution:"\uc815\uc8c4\uc758 \ub208\uae38 \ub300\uc2e0 \uc8fc\ub2d8\uc758 \uae0d\ud73c\ud55c \ub208\uae38\ub85c \ud0c0\uc778\uc744 \ub300\ud558\uae30"},en:{prayer:"With the fruit of kindness, let me have pity on those in need of mercy.",resolution:"Treat others with a look of mercy rather than condemnation."}},{ko:{prayer:"\uc591\uc120\uc758 \uc5f4\ub9e4\ub85c \uc81c \uc0b6\uc5d0 \uc120\ud55c \uc601\ud5a5\ub825\uc774 \uac00\ub4dd\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\ub2e4\ub978 \uc0ac\ub78c\uc774 \uc54c\uc544\uc8fc\uc9c0 \uc54a\uc544\ub3c4 \uc740\ubc00\ud558\uac8c \uc120\ud55c \uc77c \ud589\ud558\uae30"},en:{prayer:"Fill my life with good influence with the fruit of goodness.",resolution:"Secretly do good deeds even if others don't recognize it."}},{ko:{prayer:"\ucda9\uc131\uc758 \uc5f4\ub9e4\ub85c \ub0b4\uac8c \ub9e1\uaca8\uc9c4 \ubaa8\ub4e0 \uc0ac\uba85\uc744 \uc131\uc2e4\ud788 \uac10\ub2f9\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\uac8c\uc73c\ub984\uc744 \uc774\uae30\uace0 \uc624\ub298 \ub098\uc5d0\uac8c \uc8fc\uc5b4\uc9c4 \uc77c\uc744 \uae30\ub3c4\ub85c \uc644\uc218\ud558\uae30"},en:{prayer:"Faithfully fulfill all the tasks given to me with the fruit of faithfulness.",resolution:"Overcome laziness and complete the tasks given to you today with prayer."}},{ko:{prayer:"\uc628\uc720\uc758 \uc5f4\ub9e4\ub85c \uc800\uc758 \uac70\uce5c \uc131\ud488\uc774 \uc608\uc218\ub2d8\uc744 \ub2ee\uc544 \ubd80\ub4dc\ub7ec\uc6cc\uc9c0\uac8c \ud558\uc18c\uc11c.",resolution:"\ud654\uac00 \ub098\ub294 \uc21c\uac04\uc5d0\ub3c4 \ubd80\ub4dc\ub7ec\uc6b4 \ub300\ub2f5\uc73c\ub85c \uac08\ub4f1\uc744 \uac00\ub77c\uc549\ud788\uae30"},en:{prayer:"Let my rough character become soft like Jesus with the fruit of gentleness.",resolution:"Calm conflicts with soft answers even in moments of anger."}},{ko:{prayer:"\uc808\uc81c\uc758 \uc5f4\ub9e4\ub85c \uc800\uc758 \uc695\ub9dd\uc774 \uc8fc\ub2d8\uc758 \ud1b5\uc81c \uc544\ub798 \uc788\uac8c \ud558\uc18c\uc11c.",resolution:"\uc9c0\ub098\uce5c \uc2dd\uc695\uc774\ub098 \ubb3c\uc695\uc73c\ub85c\ubd80\ud130 \uc8fc\ub2d8\uc758 \ud1b5\uc81c\ub97c \uc2e4\ucc9c\ud558\uae30"},en:{prayer:"Let my desires be under Your control with the fruit of self-control.",resolution:"Practice God's control over excessive appetite or greed."}},{ko:{prayer:"\uc624\ub298 \uc81c \uc0b6 \uc18d\uc5d0 \ucc3e\uc544\uc624\ub294 \ubaa8\ub4e0 \uc720\ud639\uc744 \uae30\ub3c4\ub85c \ubb3c\ub9ac\uce58\uac8c \ud558\uc18c\uc11c.",resolution:"\uc720\ud639\uc758 \uc21c\uac04\uc5d0 '\ud558\ub098\ub2d8 \ub3c4\uc640\uc8fc\uc138\uc694'\ub77c\uace0 \uc989\uc2dc \uace0\ubc31\ud558\uae30"},en:{prayer:"Banish all temptations that come into my life today through prayer.",resolution:"Immediately confess 'God, help me' in moments of temptation."}},{ko:{prayer:"\uc8fc\ub2d8, \uc81c \uc601\uc758 \ub208\uc744 \ubc1d\uac8c \ud558\uc154\uc11c \uc8fc\ub2d8\uc758 \uc784\uc7ac\ub97c \ubcf4\uac8c \ud558\uc18c\uc11c.",resolution:"\ub208\uc5d0 \ubcf4\uc774\ub294 \uc0c1\ud669\ubcf4\ub2e4 \ub208\uc5d0 \ubcf4\uc774\uc9c0 \uc54a\ub294 \ud558\ub098\ub2d8\uc744 \uc2e0\ub8b0\ud558\uae30"},en:{prayer:"Lord, enlighten my spiritual eyes to see Your presence.",resolution:"Trust the invisible God over visible situations."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \uc74c\uc131\uc744 \ub4e3\ub294 \uadc0\ub97c \uc5f4\uc5b4 \uc8fc\uc154\uc11c \uc21c\uc885\uc758 \uae38\ub85c \uac77\uac8c \ud558\uc18c\uc11c.",resolution:"\ub098\uc758 \uc0dd\uac01\uc73c\ub85c \uac00\ub4dd\ud55c \ub9c8\uc74c\uc5d0 \ub9d0\uc500\uc758 \uc74c\uc131\uc744 \ucc44\uc6b0\uae30"},en:{prayer:"Open my ears to hear Your voice and walk in the path of obedience.",resolution:"Fill your heart full of your own thoughts with the voice of the Word."}},{ko:{prayer:"\uc8fc\ub2d8\uc774 \uc8fc\uc2e0 \ud46f\ub300\ub97c \ud5a5\ud558\uc5ec \uc624\ub298 \uc9c8\uc8fc\ud558\ub294 \uae30\uc068\uc744 \uc8fc\uc18c\uc11c.",resolution:"\ub4a4\uc758 \uac83\uc740 \uc78a\uc5b4\ubc84\ub9ac\uace0 \uc624\uc9c1 \uc55e\uc5d0 \uc788\ub294 \uac83\uc744 \uc7a1\uc73c\ub7ec \ub098\uac00\uae30"},en:{prayer:"Grant me the joy of sprinting toward the mark the Lord has given.",resolution:"Forget as what is behind and press on to what is ahead."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \uc601\uad11\uc774\ub77c\ub294 \ud46f\ub300\ub97c \uc78a\uc9c0 \uc54a\uace0 \ub298 \uc55e\ub9cc \ubcf4\uace0 \uac77\uac8c \ud558\uc18c\uc11c.",resolution:"\ubc29\ud669\ud558\uae30\ubcf4\ub2e4 \ud558\ub098\ub2d8\uc758 \ub73b\uc774\ub77c\ub294 \ud55c \ubc29\ud5a5\uc73c\ub85c \uc804\uc9c4\ud558\uae30"},en:{prayer:"Don't forget the mark of Your glory and always walk looking forward.",resolution:"Advance in one direction, God's will, rather than wandering."}},{ko:{prayer:"\uc81c \uc601\ud63c\uc758 \ub2fb\uc744 \uc624\uc9c1 \uc8fc\ub2d8\uaed8 \ub0b4\ub824 \ud754\ub4e4\ub9bc \uc5c6\ub294 \uc0b6\uc774 \ub418\uac8c \ud558\uc18c\uc11c.",resolution:"\uc0b6\uc758 \ud48d\ub791\uc774 \uccd0\ub3c4 \uc8fc\ub2d8\uc758 \uc57d\uc18d \uc704\uc5d0 \uad73\uac74\ud788 \uc11c \uc788\uae30"},en:{prayer:"Let me drop the anchor of my soul only in the Lord for a steady life.",resolution:"Stand firm on God's promises even when life's storms hit."}},{ko:{prayer:"\uc8fc\ub2d8\uc758 \uc9c0\uc0c1 \uba85\ub839\uc744 \uae30\uc5b5\ud558\uba70 \ubcf5\uc74c\uc758 \uc99d\uc778\uc73c\ub85c \uc0b4\uac8c \ud558\uc18c\uc11c.",resolution:"\uc624\ub298 \ub9cc\ub098\ub294 \ub204\uad70\uac00\uc5d0\uac8c \uc8fc\ub2d8\uc758 \uc0ac\ub791\uacfc \ubcf5\uc74c\uc744 \uc804\ud558\uae30"},en:{prayer:"Remembering Your great commission, help me live as a witness of the gospel.",resolution:"Share the Lord's love and gospel with someone you meet today."}},{ko:{prayer:"\uc120\ud55c \ubaa9\uc790 \ub418\uc2e0 \uc608\uc218\ub2d8\uc744 \ub530\ub974\uba70 \uae38\uc744 \uc783\uc9c0 \uc54a\uac8c \ud558\uc18c\uc11c.",resolution:"\uc8fc\ub2d8\uc758 \uc9c0\ud321\uc774\uc640 \ub9c9\ub300\uae30\uac00 \ub098\ub97c \uc548\uc704\ud558\uc2ec\uc744 \ubbff\uace0 \uc548\uc2ec\ud558\uae30"},en:{prayer:"Follow Jesus, my Good Shepherd, and help me not to lose my way.",resolution:"Rest in the assurance that Your rod and staff comfort me."}},{ko:{prayer:"\uc8fc\ub2d8\uaed8 \ub4dc\ub824\uc9c0\ub294 \uc0b0 \uc81c\ubb3c\ucc98\ub7fc \uc81c \uc0b6\uc744 \uc628\uc804\ud788 \uac70\ub8e9\ud558\uac8c \ud558\uc18c\uc11c.",resolution:"\uc138\uc0c1\uc744 \ubcf8\ubc1b\uc9c0 \uc54a\uace0 \ub9c8\uc74c\uc74